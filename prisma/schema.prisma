generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
  importFileExtension = "js"
}

datasource db {
  provider = "sqlite"
}

model Account {
  id        String   @id
  balance   Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}
